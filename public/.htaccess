# Front controller for Apache 2.4 / LiteSpeed.
DirectoryIndex index.php

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Owner, 2026-11-18: /driver opens Dispatch's built-in driver app (its public/driver folder), which runs on the Dispatch
    # address because it calls /driver-api there. Dev server only (the host check); the path after /driver/ is kept.
    RewriteCond %{HTTP_HOST} ^driver\.safeway-dispatch\.dev\.rp021\.webhelplogin\.com$ [NC]
    RewriteRule ^driver(?:/(.*))?$ https://dispatch.safeway-dispatch.dev.rp021.webhelplogin.com/driver/$1 [R=302,L]

    # Determine the RewriteBase automatically (app in a sub-folder) and expose it as BASE.
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    # Pass the Authorization header through to PHP (API bearer tokens).
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Redirect /index.php/... to the clean URL.
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    # Anything that is not a real file goes to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>
